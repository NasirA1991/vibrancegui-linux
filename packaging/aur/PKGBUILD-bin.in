# Maintainer: Nasir A. <112448715+NasirA1991@users.noreply.github.com>
pkgname=vibrancegui-linux-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Unofficial VibranceGUI-style vkSumi profile manager for Linux (prebuilt)"
arch=('x86_64')
url="https://github.com/NasirA1991/vibrancegui-linux"
license=('MIT')
depends=(
  'gcc-libs'
  'glibc'
  'fontconfig'
  'openssl'
  'libglvnd'
  'wayland'
  'libxkbcommon'
  'libx11'
  'libxcursor'
  'libxi'
  'libxrandr'
  'libxinerama'
)
optdepends=(
  'vksumi: Vulkan color grading layer required to apply adjustments'
  'steam: Steam game library integration'
  'xdg-desktop-portal: native file picker for Add manually'
)
provides=('vibrancegui-linux')
conflicts=('vibrancegui-linux')
source=(
  "vibrancegui-$pkgver::https://github.com/NasirA1991/vibrancegui-linux/releases/download/v$pkgver/vibrancegui"
  "vibrancegui-linux-$pkgver.tar.gz::https://github.com/NasirA1991/vibrancegui-linux/archive/refs/tags/v$pkgver.tar.gz"
)
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/vibrancegui-$pkgver" "$pkgdir/usr/bin/vibrancegui"
  cd "$srcdir/vibrancegui-linux-$pkgver"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 packaging/vibrancegui.desktop "$pkgdir/usr/share/applications/vibrancegui.desktop"
  install -Dm644 packaging/vibrancegui.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/vibrancegui.svg"
}
